# Public BUILD configuration, never backend secrets.
# Fill base HTTPS origins only after domain allocation. Clients append /api/v1.
VITE_APP_ENV=staging
VITE_API_URL=
VITE_AUTH_API_URL=
VITE_EVOAI_API_URL=
VITE_AGENT_PROCESSOR_URL=
VITE_WS_URL=
# Campaigns still need an EvoFlow gateway route; do not silently route to CRM.
VITE_EVOFLOW_API_URL=
