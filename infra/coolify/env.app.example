# Required runtime inputs. Store actual values in Coolify/cofre; never source untrusted env files.
DEPLOYMENT_OWNER=
GATEWAY_IMAGE=
AUTH_IMAGE=
CRM_IMAGE=
CORE_IMAGE=
PROCESSOR_IMAGE=
BOT_IMAGE=
EVOFLOW_IMAGE=
# Exact validated origins, no trailing slash.
FRONTEND_ORIGIN=
API_ORIGIN=
# Supabase Connect: runtime role, direct/session connection. No Data API keys here.
MAIN_DB_HOST=
MAIN_DB_PORT=
MAIN_DB_NAME=postgres
MAIN_DB_USER=
MAIN_DB_PASSWORD=
# DSN includes sslmode=verify-full&sslrootcert=/run/configs/main-db-ca.pem
MAIN_DB_DSN=
# Certificate PEM values are multiline Coolify configuration fields.
MAIN_DB_CA_PEM=
# EvoFlow uses the same project/database with its own schema and restricted role.
FLOW_DB_USER=
FLOW_DB_PASSWORD=
# Shared secrets generated once, not separately per consumer.
SECRET_KEY_BASE=
JWT_SECRET_KEY=
DOORKEEPER_JWT_SECRET_KEY=
ENCRYPTION_KEY=
EVOAI_CRM_API_TOKEN=
BOT_RUNTIME_SECRET=
AUTH_APIKEY_INTEGRATION_LOCAL=
# Fill actual names generated by Coolify, including UUID suffixes where required.
AUTH_UPSTREAM=
CRM_UPSTREAM=
CORE_UPSTREAM=
PROCESSOR_UPSTREAM=
BOT_RUNTIME_UPSTREAM=
EVOFLOW_UPSTREAM=
AUTH_INTERNAL_ORIGIN=
CRM_INTERNAL_ORIGIN=
CORE_INTERNAL_ORIGIN=
PROCESSOR_INTERNAL_ORIGIN=
BOT_INTERNAL_ORIGIN=
EVOFLOW_INTERNAL_ORIGIN=
REDIS_HOST=
REDIS_PASSWORD=
AUTH_REDIS_URL=
CRM_REDIS_URL=
BOT_REDIS_URL=
RABBITMQ_URL=
CLICKHOUSE_HOST=
CLICKHOUSE_PASSWORD=
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
ARTIFACT_ENDPOINT=
MEDIA_HOST_ALLOWLIST=
# Optional until authorized email tests; record T14 BLOCKED if omitted.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_SENDER_EMAIL=
