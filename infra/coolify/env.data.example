# Input for the NEW data resource only. Empty values deliberately block Compose.
# Generate the owner marker once and store it in the deployment manifest.
DEPLOYMENT_OWNER=
# Must be actual image@sha256 references verified for linux/amd64.
REDIS_IMAGE=
RABBITMQ_IMAGE=
CLICKHOUSE_IMAGE=
# Dedicated secrets: do not use credentials from existing resources.
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
RABBITMQ_ERLANG_COOKIE=
CLICKHOUSE_PASSWORD=
