# Required runtime inputs for the Cloudflare Tunnel connectors.
# Store actual values in Coolify; never commit them.
DEPLOYMENT_OWNER=
# Pin a verified digest, for example cloudflare/cloudflared@sha256:<digest>.
CLOUDFLARED_IMAGE=
# UUID returned when the tunnel was created. Not a secret on its own, but the
# credentials file it pairs with is.
TUNNEL_ID=
